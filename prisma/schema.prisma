generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseCategory {
  EXPENSE
  LIFESTYLE
  INVESTMENT
  EMERGENCY_FUND
}

enum PaymentCurrency {
  PKR
  USD
  GBP
  EUR
  AUD
  AED
}

enum ClientStatus {
  ACTIVE
  DEAD
}

enum ContractPaymentType {
  PROJECT
  MILESTONE
}

enum ContractStatus {
  PROPOSED
  UPFRONT_PAYMENT
  ACTIVE
  PENDING_PAYMENT
  PARTIALLY_PAID
  COMPLETED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

/// An incoming payment. Recorded in PKR; the original foreign-currency
/// amount is kept only for reference and never used in calculations.
/// On creation, netEarning (amount - teamPay) is split across the
/// distribution buckets per lib/finance/constants.ts.
model Earning {
  id                String           @id @default(cuid())
  date              DateTime         @db.Date
  name              String
  amount            Decimal          @db.Decimal(14, 2)
  teamPay           Decimal          @default(0) @db.Decimal(14, 2)
  referenceAmount   Decimal?         @db.Decimal(14, 2)
  referenceCurrency PaymentCurrency?
  invoiceId         String?          @unique
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdByUserId   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([date])
}

/// A spend against one of the four non-donation buckets.
model Expense {
  id              String          @id @default(cuid())
  date            DateTime        @db.Date
  category        ExpenseCategory
  name            String
  amount          Decimal         @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([date])
  @@index([category])
}

/// A payment out of the donation bucket.
model Donation {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  name            String
  amount          Decimal  @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}

/// A client contact and their payment/status details.
model Client {
  id              String          @id @default(cuid())
  name            String
  phone           String
  email           String
  country         String
  currency        PaymentCurrency
  status          ClientStatus    @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contracts       Contract[]
  invoices        Invoice[]

  @@index([status])
  @@index([name])
}

/// A project engagement with a client, billed either as one project amount
/// or split across milestones (see Milestone). If teamMemberId is set, the
/// work is outsourced to that team member for teamPayAmount (PKR); if null,
/// the work is handled in-house and no team cut is deducted from earning.
model Contract {
  id              String              @id @default(cuid())
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id])
  date            DateTime            @db.Date
  deadline        DateTime            @db.Date
  projectName     String
  description     String?
  currency        PaymentCurrency
  paymentType     ContractPaymentType
  amount          Decimal?            @db.Decimal(14, 2)
  status          ContractStatus      @default(PROPOSED)
  teamMemberId    String?
  teamMember      TeamMember?         @relation(fields: [teamMemberId], references: [id])
  teamPayAmount   Decimal?            @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  milestones      Milestone[]
  invoiceLinks    InvoiceContract[]
  invoiceItems    InvoiceItem[]
  payslips        Payslip[]

  @@index([status])
  @@index([clientId])
  @@index([teamMemberId])
}

/// An outsourced contractor or team member who can be assigned to a
/// contract's work and paid via a Payslip.
model TeamMember {
  id              String           @id @default(cuid())
  name            String
  phone           String?
  email           String?
  country         String?
  currency        PaymentCurrency?
  address         String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  contracts       Contract[]
  payslips        Payslip[]

  @@index([name])
}

/// A generated payslip paying a team member for a period of work. contractId
/// is an optional "assigned project" shown on the payslip so the team member
/// knows what the payment is for; it carries no financial logic on its own.
/// See lib/team/constants.ts for the numbering scheme.
model Payslip {
  id              String      @id @default(cuid())
  number          Int         @unique
  teamMemberId    String
  teamMember      TeamMember  @relation(fields: [teamMemberId], references: [id])
  contractId      String?
  contract        Contract?   @relation(fields: [contractId], references: [id])
  periodStart     DateTime    @db.Date
  periodEnd       DateTime    @db.Date
  issueDate       DateTime    @db.Date
  amount          Decimal     @db.Decimal(14, 2)
  note            String?
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  teamPayment     TeamPayment?

  @@index([teamMemberId])
  @@index([contractId])
}

/// A team payment recorded in the finance ledger — created alongside a
/// Payslip only when that payment isn't already reflected in an existing
/// Earning.teamPay deduction (see actions/team/payslip-actions.ts), so
/// money leaving the company for team pay is never counted twice but is
/// always accounted for somewhere.
model TeamPayment {
  id              String   @id @default(cuid())
  date            DateTime @db.Date
  name            String
  amount          Decimal  @db.Decimal(14, 2)
  payslipId       String?  @unique
  payslip         Payslip? @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}

/// One installment of a milestone-billed contract.
model Milestone {
  id           String        @id @default(cuid())
  contractId   String
  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name         String
  amount       Decimal       @db.Decimal(14, 2)
  deadline     DateTime      @db.Date
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]

  @@index([contractId])
}

/// A company bank account to receive client payments. The set of populated
/// fields below depends on currency — see lib/bank-accounts/constants.ts.
model BankAccount {
  id                String          @id @default(cuid())
  currency          PaymentCurrency
  bankName          String
  accountHolderName String
  accountType       String?
  routingNumber     String?
  accountNumber     String?
  iban              String?
  sortCode          String?
  bsbCode           String?
  swift             String
  createdByUserId   String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  invoices          Invoice[]

  @@index([currency])
}

/// A generated invoice billing one or more contracts of a single client, in
/// one currency. See lib/invoices/constants.ts for the numbering scheme and
/// the fixed company details rendered on the PDF.
model Invoice {
  id              String            @id @default(cuid())
  number          Int               @unique
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  bankAccountId   String
  bankAccount     BankAccount       @relation(fields: [bankAccountId], references: [id])
  currency        PaymentCurrency
  discount        Decimal           @default(0) @db.Decimal(14, 2)
  issueDate       DateTime          @db.Date
  dueDate         DateTime          @db.Date
  status          InvoiceStatus     @default(UNPAID)
  paidOn          DateTime?         @db.Date
  transactionId   String?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  earning         Earning?
  items           InvoiceItem[]
  contracts       InvoiceContract[]

  @@index([status])
  @@index([clientId])
}

/// One billable line on an invoice — a project's full amount, or a single
/// milestone installment — snapshotted at invoice-creation time. contractId/
/// milestoneId trace the line back to its source so remaining balances (for
/// partial payments and "already paid" filtering) can be computed later.
model InvoiceItem {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?  @relation(fields: [contractId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  description String
  amount      Decimal    @db.Decimal(14, 2)
  isPartial   Boolean    @default(false)
  sortOrder   Int        @default(0)

  @@index([invoiceId])
  @@index([contractId])
  @@index([milestoneId])
}

/// Links an invoice to the contract(s) it bills, so paying the invoice can
/// mark those contracts completed.
model InvoiceContract {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  @@unique([invoiceId, contractId])
  @@index([contractId])
}
