generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseCategory {
  EXPENSE
  LIFESTYLE
  INVESTMENT
  EMERGENCY_FUND
}

enum PaymentCurrency {
  PKR
  USD
  GBP
  EUR
  AUD
  AED
}

enum ClientStatus {
  ACTIVE
  DEAD
}

enum ContractPaymentType {
  PROJECT
  MILESTONE
}

enum ContractStatus {
  PROPOSED
  UPFRONT_PAYMENT
  ACTIVE
  PENDING_PAYMENT
  PARTIALLY_PAID
  COMPLETED
  PAUSED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum LedgerEntryType {
  EARNING
  EXPENSE
  DONATION
  TEAM_PAYMENT
}

enum TeamMemberType {
  PROJECT_BASED
  HOURLY
}

enum UserKind {
  DASHBOARD_HANDLER
  TEAM
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions RolePermission[]
  users       AppUser[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

/// One row per page a role has any access to — a page with no row for a
/// role means no access at all. canView gates both nav visibility and
/// whether the page itself renders for that role.
model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  page      String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([roleId, page])
}

/// Our own record of an authenticated identity, keyed to Neon Auth's user
/// id (authUserId). kind decides which half of the app they get:
/// DASHBOARD_HANDLER (roleId required) or TEAM (teamMemberId required,
/// linking to an existing TeamMember so a team login only ever sees their
/// own data).
model AppUser {
  id           String      @id @default(cuid())
  authUserId   String      @unique
  email        String      @unique
  name         String
  kind         UserKind
  roleId       String?
  role         Role?       @relation(fields: [roleId], references: [id])
  teamMemberId String?     @unique
  teamMember   TeamMember? @relation(fields: [teamMemberId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Earning {
  id                String           @id @default(cuid())
  date              DateTime         @db.Date
  name              String
  amount            Decimal          @db.Decimal(14, 2)
  teamPay           Decimal          @default(0) @db.Decimal(14, 2)
  referenceAmount   Decimal?         @db.Decimal(14, 2)
  referenceCurrency PaymentCurrency?
  invoiceId         String?          @unique
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdByUserId   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ledgerEntries     LedgerEntry[]

  @@index([date])
}

/// A spend against one of the four non-donation buckets.
model Expense {
  id              String          @id @default(cuid())
  date            DateTime        @db.Date
  category        ExpenseCategory
  name            String
  amount          Decimal         @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ledgerEntries   LedgerEntry[]

  @@index([date])
  @@index([category])
}

/// A payment out of the donation bucket.
model Donation {
  id              String        @id @default(cuid())
  date            DateTime      @db.Date
  name            String
  amount          Decimal       @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ledgerEntries   LedgerEntry[]

  @@index([date])
}

/// A client contact and their payment/status details.
model Client {
  id              String          @id @default(cuid())
  name            String
  phone           String
  email           String
  country         String
  currency        PaymentCurrency
  status          ClientStatus    @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  contracts       Contract[]
  invoices        Invoice[]

  @@index([status])
  @@index([name])
}

model Contract {
  id              String              @id @default(cuid())
  clientId        String
  client          Client              @relation(fields: [clientId], references: [id])
  date            DateTime            @db.Date
  deadline        DateTime            @db.Date
  projectName     String
  description     String?
  currency        PaymentCurrency
  paymentType     ContractPaymentType
  amount          Decimal?            @db.Decimal(14, 2)
  status          ContractStatus      @default(PROPOSED)
  teamMemberId    String?
  teamMember      TeamMember?         @relation(fields: [teamMemberId], references: [id])
  teamPayAmount   Decimal?            @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  milestones      Milestone[]
  invoiceLinks    InvoiceContract[]
  invoiceItems    InvoiceItem[]
  payslips        Payslip[]
  messages        ContractMessage[]

  @@index([status])
  @@index([clientId])
  @@index([teamMemberId])
}

/// One post in a contract's project chat — a running log of notes between
/// whoever can see the project (dashboard team, the assigned team member,
/// and eventually the client). authorName is snapshotted at send time so
/// a later rename or account removal doesn't rewrite who said what.
model ContractMessage {
  id           String   @id @default(cuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  authorUserId String
  authorName   String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  @@index([contractId])
}


model TeamMember {
  id              String           @id @default(cuid())
  name            String
  phone           String?
  email           String?
  country         String?
  currency        PaymentCurrency
  address         String?
  type            TeamMemberType   @default(PROJECT_BASED)
  hourlyRate      Decimal?         @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  contracts       Contract[]
  payslips        Payslip[]
  workDiaryEntries WorkDiaryEntry[]
  appUser         AppUser?

  @@index([name])
}

model WorkDiaryEntry {
  id              String     @id @default(cuid())
  teamMemberId    String
  teamMember      TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  weekStart       DateTime   @db.Date
  weekEnd         DateTime   @db.Date
  hours           Decimal    @db.Decimal(6, 2)
  amount          Decimal?   @db.Decimal(14, 2)
  notes           String?
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([teamMemberId, weekStart])
  @@index([teamMemberId])
  @@index([weekStart])
}

model Payslip {
  id              String      @id @default(cuid())
  number          Int         @unique
  teamMemberId    String
  teamMember      TeamMember  @relation(fields: [teamMemberId], references: [id])
  contractId      String?
  contract        Contract?   @relation(fields: [contractId], references: [id])
  periodStart     DateTime    @db.Date
  periodEnd       DateTime    @db.Date
  issueDate       DateTime    @db.Date
  amount          Decimal     @db.Decimal(14, 2)
  note            String?
  createdByUserId String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  teamPayment     TeamPayment?

  @@index([teamMemberId])
  @@index([contractId])
}


model TeamPayment {
  id              String        @id @default(cuid())
  date            DateTime      @db.Date
  name            String
  amount          Decimal       @db.Decimal(14, 2)
  payslipId       String?       @unique
  payslip         Payslip?      @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ledgerEntries   LedgerEntry[]

  @@index([date])
}

model LedgerEntry {
  id            String          @id @default(cuid())
  type          LedgerEntryType
  name          String
  date          DateTime        @db.Date
  debit         Decimal         @default(0) @db.Decimal(14, 2)
  credit        Decimal         @default(0) @db.Decimal(14, 2)
  earningId     String?
  earning       Earning?        @relation(fields: [earningId], references: [id], onDelete: Cascade)
  expenseId     String?
  expense       Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  donationId    String?
  donation      Donation?       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  teamPaymentId String?
  teamPayment   TeamPayment?    @relation(fields: [teamPaymentId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([type])
}

/// One installment of a milestone-billed contract.
model Milestone {
  id           String        @id @default(cuid())
  contractId   String
  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name         String
  amount       Decimal       @db.Decimal(14, 2)
  deadline     DateTime      @db.Date
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]

  @@index([contractId])
}

model BankAccount {
  id                String          @id @default(cuid())
  currency          PaymentCurrency
  bankName          String
  accountHolderName String
  accountType       String?
  routingNumber     String?
  accountNumber     String?
  iban              String?
  sortCode          String?
  bsbCode           String?
  swift             String
  createdByUserId   String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  invoices          Invoice[]

  @@index([currency])
}

model Invoice {
  id              String            @id @default(cuid())
  number          Int               @unique
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id])
  bankAccountId   String
  bankAccount     BankAccount       @relation(fields: [bankAccountId], references: [id])
  currency        PaymentCurrency
  discount        Decimal           @default(0) @db.Decimal(14, 2)
  issueDate       DateTime          @db.Date
  dueDate         DateTime          @db.Date
  status          InvoiceStatus     @default(UNPAID)
  paidOn          DateTime?         @db.Date
  transactionId   String?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  earning         Earning?
  items           InvoiceItem[]
  contracts       InvoiceContract[]

  @@index([status])
  @@index([clientId])
}

model InvoiceItem {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?  @relation(fields: [contractId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  description String
  amount      Decimal    @db.Decimal(14, 2)
  isPartial   Boolean    @default(false)
  sortOrder   Int        @default(0)

  @@index([invoiceId])
  @@index([contractId])
  @@index([milestoneId])
}

/// Links an invoice to the contract(s) it bills, so paying the invoice can
/// mark those contracts completed.
model InvoiceContract {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  @@unique([invoiceId, contractId])
  @@index([contractId])
}
