generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExpenseCategory {
  EXPENSE
  LIFESTYLE
  INVESTMENT
  EMERGENCY_FUND
}

enum PaymentCurrency {
  PKR
  USD
  GBP
  EUR
  AUD
  AED
}

enum ClientStatus {
  ACTIVE
  DEAD
}

enum ContractPaymentType {
  PROJECT
  MILESTONE
}

enum ContractStatus {
  PROPOSED
  UPFRONT_PAYMENT
  ACTIVE
  PENDING_PAYMENT
  PARTIALLY_PAID
  COMPLETED
  PAUSED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
}

enum LedgerEntryType {
  EARNING
  EXPENSE
  DONATION
  TEAM_PAYMENT
  PARTNER_PAYMENT
}

enum TeamMemberType {
  PROJECT_BASED
  HOURLY
}

enum UserKind {
  DASHBOARD_HANDLER
  TEAM
  CLIENT
  PARTNER
}

enum ContractWorkCostMode {
  FIXED
  PERCENTAGE
}

enum PartnerPaymentSource {
  AUTO_COMPLETION
  MANUAL
}

/// How a PartnerInvestment contribution was funded — PENDING_PAYMENT
/// redirects an already-accrued (AUTO_COMPLETION, unlinked) PartnerPayment
/// into investment instead of paying it out; CASH/ONLINE are fresh money
/// the partner hands over directly, with ONLINE optionally carrying a
/// transaction id.
enum InvestmentMethod {
  PENDING_PAYMENT
  CASH
  ONLINE
}

/// SUSPENDED and BLOCKED both block sign-in identically — they're kept as
/// two admin-facing labels because Suspended is meant as a manual, easily
/// reversed pause, while Blocked is either a manual hard stop or the
/// automatic terminal state the brute-force lockout policy sets after
/// its final tier (see AppUser.lockoutStage).
enum AppUserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  permissions RolePermission[]
  users       AppUser[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

/// One row per page a role has any access to — a page with no row for a
/// role means no access at all. canView gates both nav visibility and
/// whether the page itself renders for that role.
model RolePermission {
  id        String  @id @default(cuid())
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  page      String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([roleId, page])
}

/// Our own record of an authenticated identity, keyed to Neon Auth's user
/// id (authUserId). kind decides which half of the app they get:
/// DASHBOARD_HANDLER (roleId required), TEAM (teamMemberId required,
/// linking to an existing TeamMember so a team login only ever sees their
/// own data), or CLIENT (one or more linked Client profiles via
/// ClientProfile — a client login sees the combined data of every profile
/// linked to it, e.g. someone with both a personal and a company Client
/// record under one login).
model AppUser {
  id                          String               @id @default(cuid())
  authUserId                  String               @unique
  email                       String               @unique
  name                        String
  kind                        UserKind
  roleId                      String?
  role                        Role?                @relation(fields: [roleId], references: [id])
  teamMemberId                String?              @unique
  teamMember                  TeamMember?          @relation(fields: [teamMemberId], references: [id])
  clientProfiles              ClientProfile[]
  partnerId                   String?              @unique
  partner                     Partner?             @relation(fields: [partnerId], references: [id])
  credentialViewLinks         CredentialViewLink[]
  passwordResetCodes          PasswordResetCode[]
  status                      AppUserStatus        @default(ACTIVE)
  /// Consecutive wrong-password attempts since the last reset (a correct
  /// sign-in, or a timed lockout expiring into the next tier).
  failedLoginAttempts         Int                  @default(0)
  /// How many timed lockout tiers ([5, 15, 60] minutes) have already been
  /// used since the last successful sign-in — the 4th violation blocks
  /// the account permanently instead of issuing a 4th timer.
  lockoutStage                Int                  @default(0)
  lockedUntil                 DateTime?
  /// Opt-in staff alerts for DASHBOARD_HANDLER logins whose role can view
  /// contracts: new project proposals from the client/partner portals, and
  /// new client chat messages. ADMIN_NOTIFY_EMAIL always gets both
  /// regardless — see lib/mail/notifications/recipients.ts.
  projectNotificationsEnabled Boolean              @default(false)
  chatNotificationsEnabled    Boolean              @default(false)
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
}

model Earning {
  id                String           @id @default(cuid())
  date              DateTime         @db.Date
  name              String
  amount            Decimal          @db.Decimal(14, 2)
  teamPay           Decimal          @default(0) @db.Decimal(14, 2)
  /// Aggregate partner profit-share booked against this invoice's
  /// completing contracts (see markInvoicePaid) — same role as teamPay,
  /// feeding net-earning KPIs. Not attributable back to one partner; use
  /// PartnerPayment for that.
  partnerShare      Decimal          @default(0) @db.Decimal(14, 2)
  /// Aggregate ProjectExpense sum for this invoice's completing contracts
  /// (every contract, partnered or not) — also nets out of net earning.
  projectExpenses   Decimal          @default(0) @db.Decimal(14, 2)
  referenceAmount   Decimal?         @db.Decimal(14, 2)
  referenceCurrency PaymentCurrency?
  invoiceId         String?          @unique
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdByUserId   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ledgerEntries     LedgerEntry[]

  @@index([date])
}

/// A spend against one of the four non-donation buckets.
model Expense {
  id              String          @id @default(cuid())
  date            DateTime        @db.Date
  category        ExpenseCategory
  name            String
  amount          Decimal         @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ledgerEntries   LedgerEntry[]

  @@index([date])
  @@index([category])
}

/// A payment out of the donation bucket.
model Donation {
  id              String        @id @default(cuid())
  date            DateTime      @db.Date
  name            String
  amount          Decimal       @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ledgerEntries   LedgerEntry[]

  @@index([date])
}

/// A client contact and their payment/status details.
model Client {
  id                        String          @id @default(cuid())
  name                      String
  phone                     String
  email                     String
  country                   String
  currency                  PaymentCurrency
  status                    ClientStatus    @default(ACTIVE)
  emailNotificationsEnabled Boolean         @default(true)
  /// Attribution only — which partner originated this client. Independent
  /// of Contract.partnerId (the profit-share partner on a given project),
  /// though a partner-initiated contract normally sets both to the same
  /// partner.
  broughtByPartnerId        String?
  broughtByPartner          Partner?        @relation(fields: [broughtByPartnerId], references: [id])
  /// Per-client toggles an admin flips on to let the attributed partner
  /// see this specific client's contact details in the partner portal —
  /// both default hidden.
  phoneVisibleToPartner     Boolean         @default(false)
  emailVisibleToPartner     Boolean         @default(false)
  createdByUserId           String
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  contracts                 Contract[]
  invoices                  Invoice[]
  clientProfiles            ClientProfile[]

  @@index([broughtByPartnerId])
  @@index([status])
  @@index([name])
}

/// A one-time password-view link handed out by a "new/reset credentials"
/// email. The plaintext password only ever exists encrypted here, and
/// only until the first (and only) successful view, at which point
/// passwordCiphertext is wiped — usedAt alone isn't trusted as the sole
/// guard against a second view.
model CredentialViewLink {
  id                 String    @id @default(cuid())
  appUserId          String
  appUser            AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  tokenHash          String    @unique
  passwordCiphertext String?
  expiresAt          DateTime
  usedAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([appUserId])
}

/// A "forgot password" one-time 6-digit code — hashed at rest, short-lived,
/// and attempt-limited so a 6-digit space isn't brute-forceable within its
/// window. A fresh request invalidates any prior unused code for the same
/// user (see requestPasswordResetCode).
model PasswordResetCode {
  id        String    @id @default(cuid())
  appUserId String
  appUser   AppUser   @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([appUserId])
}

/// Links one CLIENT-kind AppUser to one Client record it can act as. A
/// login can have several of these (e.g. a personal-project profile and a
/// separate company profile) — the client portal always shows the union
/// of every linked, still-ACTIVE Client's data.
model ClientProfile {
  id        String   @id @default(cuid())
  appUserId String
  appUser   AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  @@unique([appUserId, clientId])
  @@index([clientId])
}

model Contract {
  id                       String                @id @default(cuid())
  clientId                 String
  client                   Client                @relation(fields: [clientId], references: [id])
  date                     DateTime              @db.Date
  deadline                 DateTime              @db.Date
  projectName              String
  description              String?
  currency                 PaymentCurrency
  paymentType              ContractPaymentType
  amount                   Decimal?              @db.Decimal(14, 2)
  status                   ContractStatus        @default(PROPOSED)
  teamMemberId             String?
  teamMember               TeamMember?           @relation(fields: [teamMemberId], references: [id])
  /// The resolved work-cost figure in PKR, whichever workCostMode produced
  /// it — every existing consumer (pending-payment KPIs, markInvoicePaid's
  /// teamPay sum, payslips) keeps reading this one column unchanged.
  teamPayAmount            Decimal?              @db.Decimal(14, 2)
  statusEmailsEnabled      Boolean               @default(true)
  chatNotificationsEnabled Boolean               @default(false)
  partnerId                String?
  partner                  Partner?              @relation(fields: [partnerId], references: [id])
  /// Only meaningful when partnerId is set. FIXED = teamPayAmount typed
  /// directly (same as a non-partnered contract); PERCENTAGE = teamPayAmount
  /// is derived from workCostPercent × revenue at save time.
  workCostMode             ContractWorkCostMode?
  workCostPercent          Decimal?              @db.Decimal(5, 2)
  /// Overrides Partner.sharePercentage for this contract only; null = use
  /// the partner's default at booking time.
  partnerSharePercent      Decimal?              @db.Decimal(5, 2)
  createdByUserId          String
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  milestones               Milestone[]
  invoiceLinks             InvoiceContract[]
  invoiceItems             InvoiceItem[]
  payslips                 Payslip[]
  messages                 ContractMessage[]
  projectExpenses          ProjectExpense[]
  partnerPayments          PartnerPayment[]
  partnerPayslips          PartnerPayslip[]

  @@index([status])
  @@index([clientId])
  @@index([teamMemberId])
  @@index([partnerId])
}

model ContractMessage {
  id           String   @id @default(cuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  authorUserId String
  authorName   String
  authorKind   UserKind
  body         String   @db.Text
  createdAt    DateTime @default(now())

  @@index([contractId])
}

model TeamMember {
  id                   String           @id @default(cuid())
  name                 String
  phone                String?
  email                String?
  country              String?
  currency             PaymentCurrency
  address              String?
  type                 TeamMemberType   @default(PROJECT_BASED)
  hourlyRate           Decimal?         @db.Decimal(14, 2)
  /// Send a payslip email (with PDF) when one is issued — meaningless
  /// while email is null; the UI disables the toggle in that case.
  payslipEmailsEnabled Boolean          @default(true)
  createdByUserId      String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  contracts            Contract[]
  payslips             Payslip[]
  workDiaryEntries     WorkDiaryEntry[]
  appUser              AppUser?

  @@index([name])
}

model Partner {
  id                   String                   @id @default(cuid())
  name                 String
  phone                String?
  email                String?
  currency             PaymentCurrency
  sharePercentage      Decimal                  @db.Decimal(5, 2)
  payslipEmailsEnabled Boolean                  @default(true)
  chatEnabled          Boolean                  @default(false)
  createdByUserId      String
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  contracts            Contract[]
  clients              Client[]
  partnerPayments      PartnerPayment[]
  partnerPayslips      PartnerPayslip[]
  partnerInvestments   PartnerInvestment[]
  investmentSpends     PartnerInvestmentSpend[]
  appUser              AppUser?

  @@index([name])
}

model WorkDiaryEntry {
  id              String     @id @default(cuid())
  teamMemberId    String
  teamMember      TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  weekStart       DateTime   @db.Date
  weekEnd         DateTime   @db.Date
  hours           Decimal    @db.Decimal(6, 2)
  amount          Decimal?   @db.Decimal(14, 2)
  notes           String?
  createdByUserId String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([teamMemberId, weekStart])
  @@index([teamMemberId])
  @@index([weekStart])
}

model Payslip {
  id              String       @id @default(cuid())
  number          Int          @unique
  teamMemberId    String
  teamMember      TeamMember   @relation(fields: [teamMemberId], references: [id])
  contractId      String?
  contract        Contract?    @relation(fields: [contractId], references: [id])
  periodStart     DateTime     @db.Date
  periodEnd       DateTime     @db.Date
  issueDate       DateTime     @db.Date
  amount          Decimal      @db.Decimal(14, 2)
  note            String?
  createdByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  teamPayment     TeamPayment?

  @@index([teamMemberId])
  @@index([contractId])
}

model TeamPayment {
  id              String        @id @default(cuid())
  date            DateTime      @db.Date
  name            String
  amount          Decimal       @db.Decimal(14, 2)
  payslipId       String?       @unique
  payslip         Payslip?      @relation(fields: [payslipId], references: [id], onDelete: SetNull)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ledgerEntries   LedgerEntry[]

  @@index([date])
}

/// An ad-hoc, project-level cost the admin logs against a specific
/// Contract — unlike the top-level Expense bucket, this is scoped to one
/// project and feeds the profit-split calc as a deduction before the
/// partner's cut, and net earning generally (every contract, partnered or
/// not). Booked to the ledger immediately on creation, independent of
/// when/if the contract's invoices are ever paid.
model ProjectExpense {
  id              String        @id @default(cuid())
  contractId      String
  contract        Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  name            String
  /// Always PKR, same convention as team pay / payslips.
  amount          Decimal       @db.Decimal(14, 2)
  createdByUserId String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ledgerEntries   LedgerEntry[]

  @@index([contractId])
  @@index([date])
}

/// The outgoing-money ledger row for a partner's profit share — unlike
/// TeamPayment (only attributable back to one person via its Payslip
/// link), this carries direct partnerId/contractId FKs plus a snapshot of
/// the calc inputs, so a partner's accrued/paid totals are always
/// attributable even before any paperwork (PartnerPayslip) is issued.
model PartnerPayment {
  id                    String               @id @default(cuid())
  date                  DateTime             @db.Date
  name                  String
  partnerId             String
  partner               Partner              @relation(fields: [partnerId], references: [id])
  contractId            String?
  contract              Contract?            @relation(fields: [contractId], references: [id])
  amount                Decimal              @db.Decimal(14, 2)
  source                PartnerPaymentSource @default(MANUAL)
  /// Audit snapshot of the calc at booking time (all null for a MANUAL,
  /// no-contract payment) — a later change to Partner.sharePercentage or
  /// the contract's numbers never rewrites a historical split.
  revenueAmount         Decimal?             @db.Decimal(14, 2)
  workCostAmount        Decimal?             @db.Decimal(14, 2)
  projectExpensesAmount Decimal?             @db.Decimal(14, 2)
  profitAmount          Decimal?             @db.Decimal(14, 2)
  sharePercentageUsed   Decimal?             @db.Decimal(5, 2)
  partnerPayslipId      String?              @unique
  partnerPayslip        PartnerPayslip?      @relation(fields: [partnerPayslipId], references: [id], onDelete: SetNull)
  /// Set instead of partnerPayslipId when this accrued payment was
  /// redirected into investment (PartnerInvestment.method =
  /// PENDING_PAYMENT) rather than paid out — mutually exclusive with it in
  /// practice, enforced at the application layer (both linking actions
  /// require the payment to be fully unlinked first).
  partnerInvestmentId   String?              @unique
  partnerInvestment     PartnerInvestment?   @relation(fields: [partnerInvestmentId], references: [id], onDelete: SetNull)
  createdByUserId       String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  ledgerEntries         LedgerEntry[]

  @@index([date])
  @@index([partnerId])
  @@index([contractId])
}

/// The paperwork a partner's share is issued under — mirrors Payslip
/// exactly (no work-diary equivalent; partners have no hourly concept).
model PartnerPayslip {
  id              String          @id @default(cuid())
  number          Int             @unique
  partnerId       String
  partner         Partner         @relation(fields: [partnerId], references: [id])
  contractId      String?
  contract        Contract?       @relation(fields: [contractId], references: [id])
  periodStart     DateTime        @db.Date
  periodEnd       DateTime        @db.Date
  issueDate       DateTime        @db.Date
  amount          Decimal         @db.Decimal(14, 2)
  note            String?
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  partnerPayment  PartnerPayment?

  @@index([partnerId])
  @@index([contractId])
}

/// A partner's contribution into their own investment "wallet" — a
/// free-floating balance (not tied to any one project at contribution
/// time) that PartnerInvestmentSpend rows later draw down. Deliberately
/// kept off the money ledger/balance sheet (no LedgerEntry rows): this is
/// the partner's own money passing through, not company revenue or
/// expense. The slip issued for one of these is the investor's proof of
/// contribution, mirroring PartnerPayslip's numbering/PDF pattern.
model PartnerInvestment {
  id              String           @id @default(cuid())
  number          Int              @unique
  partnerId       String
  partner         Partner          @relation(fields: [partnerId], references: [id])
  date            DateTime         @db.Date
  amount          Decimal          @db.Decimal(14, 2)
  method          InvestmentMethod
  /// Optional even for ONLINE — some transfers have no reference number
  /// worth recording.
  transactionId   String?
  note            String?
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  partnerPayment  PartnerPayment?

  @@index([partnerId])
  @@index([date])
}

/// Where a partner's invested balance actually went — not limited to
/// projects (per the user: "upwork connects, in stocks or anywhere"), so
/// `category` is free text rather than a Contract FK. Never touches
/// ProjectExpense or the profit-split formula; purely a spend log against
/// the balance built up by that partner's PartnerInvestment rows.
model PartnerInvestmentSpend {
  id              String   @id @default(cuid())
  partnerId       String
  partner         Partner  @relation(fields: [partnerId], references: [id])
  date            DateTime @db.Date
  amount          Decimal  @db.Decimal(14, 2)
  category        String
  note            String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([partnerId])
  @@index([date])
}

model LedgerEntry {
  id               String          @id @default(cuid())
  type             LedgerEntryType
  name             String
  date             DateTime        @db.Date
  debit            Decimal         @default(0) @db.Decimal(14, 2)
  credit           Decimal         @default(0) @db.Decimal(14, 2)
  earningId        String?
  earning          Earning?        @relation(fields: [earningId], references: [id], onDelete: Cascade)
  expenseId        String?
  expense          Expense?        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  donationId       String?
  donation         Donation?       @relation(fields: [donationId], references: [id], onDelete: Cascade)
  teamPaymentId    String?
  teamPayment      TeamPayment?    @relation(fields: [teamPaymentId], references: [id], onDelete: Cascade)
  projectExpenseId String?
  projectExpense   ProjectExpense? @relation(fields: [projectExpenseId], references: [id], onDelete: Cascade)
  partnerPaymentId String?
  partnerPayment   PartnerPayment? @relation(fields: [partnerPaymentId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([date])
  @@index([type])
}

/// One installment of a milestone-billed contract.
model Milestone {
  id           String        @id @default(cuid())
  contractId   String
  contract     Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  name         String
  amount       Decimal       @db.Decimal(14, 2)
  deadline     DateTime      @db.Date
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  invoiceItems InvoiceItem[]

  @@index([contractId])
}

model BankAccount {
  id                String          @id @default(cuid())
  currency          PaymentCurrency
  bankName          String
  accountHolderName String
  accountType       String?
  routingNumber     String?
  accountNumber     String?
  iban              String?
  sortCode          String?
  bsbCode           String?
  swift             String
  createdByUserId   String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  invoices          Invoice[]

  @@index([currency])
}

model Invoice {
  id               String            @id @default(cuid())
  number           Int               @unique
  clientId         String
  client           Client            @relation(fields: [clientId], references: [id])
  bankAccountId    String
  bankAccount      BankAccount       @relation(fields: [bankAccountId], references: [id])
  currency         PaymentCurrency
  discount         Decimal           @default(0) @db.Decimal(14, 2)
  issueDate        DateTime          @db.Date
  dueDate          DateTime          @db.Date
  status           InvoiceStatus     @default(UNPAID)
  paidOn           DateTime?         @db.Date
  transactionId    String?
  /// The actual PKR amount received when this invoice was marked paid —
  /// for a PKR invoice this equals its own balance due; for any other
  /// currency it's the admin-entered PKR equivalent. Kept on the invoice
  /// itself (not just derived from Earning.amount) so the gross figure the
  /// client actually paid stays visible even though Earning.amount is net
  /// of the partner share and project expenses booked against it.
  pkrAmount        Decimal?          @db.Decimal(14, 2)
  remindersEnabled Boolean           @default(false)
  reminderCount    Int               @default(0)
  lastReminderAt   DateTime?
  createdByUserId  String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  earning          Earning?
  items            InvoiceItem[]
  contracts        InvoiceContract[]

  @@index([status])
  @@index([clientId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  summary    String
  page       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model InvoiceItem {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractId  String?
  contract    Contract?  @relation(fields: [contractId], references: [id])
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])
  description String
  amount      Decimal    @db.Decimal(14, 2)
  isPartial   Boolean    @default(false)
  sortOrder   Int        @default(0)

  @@index([invoiceId])
  @@index([contractId])
  @@index([milestoneId])
}

/// Links an invoice to the contract(s) it bills, so paying the invoice can
/// mark those contracts completed.
model InvoiceContract {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  @@unique([invoiceId, contractId])
  @@index([contractId])
}
